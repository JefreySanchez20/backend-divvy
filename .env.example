# Copia este archivo a .env y ajusta los valores. .env nunca se commitea (ver .gitignore).

# Postgres (usado por docker-compose.yml y por application.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=divvy
DB_USER=divvy
DB_PASSWORD=divvy_dev_password
# DB_SSLMODE: "disable" en local, "require" en Neon (u otro proveedor gestionado).
DB_SSLMODE=disable

# JWT (application.yml -> divvy.jwt.*)
JWT_SECRET=change-me-in-production-this-is-a-dev-only-secret-key-32bytes+
JWT_EXPIRATION_MS=86400000

# Correo de recuperación (application.yml -> divvy.email.*), vía la API HTTP de SendGrid.
# NO usar SMTP: Render bloquea los puertos SMTP salientes (25/465/587) en su plan
# gratuito, así que un envío por SMTP se queda colgado hasta hacer timeout.
# EMAIL_API_KEY: sendgrid.com -> Settings -> API Keys -> Create API Key (permiso "Mail Send").
# MAIL_FROM: el email verificado como remitente en SendGrid (Settings -> Sender Authentication).
# Nunca pongas el valor real de EMAIL_API_KEY aquí, solo en tu .env.
EMAIL_API_KEY=
MAIL_FROM=
PASSWORD_RESET_EXPIRATION_MINUTES=30

# App
# SERVER_PORT: usado en local. Render inyecta su propia variable PORT, que
# tiene prioridad automáticamente (ver application.yml -> server.port).
SERVER_PORT=8080
LOG_LEVEL=DEBUG

# CORS: orígenes permitidos separados por coma (sin espacios). En producción,
# reemplazar por el/los dominios reales del frontend (ej: https://divvy.app).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
