# Copia este archivo a .env y ajusta los valores. .env nunca se commitea (ver .gitignore).

# Postgres (usado por docker-compose.yml y por application.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=divvy
DB_USER=divvy
DB_PASSWORD=divvy_dev_password

# JWT (application.yml -> divvy.jwt.*)
JWT_SECRET=change-me-in-production-this-is-a-dev-only-secret-key-32bytes+
JWT_EXPIRATION_MS=86400000

# App
SERVER_PORT=8080
