# Copia este archivo a .env y ajusta los valores. .env nunca se commitea (ver .gitignore).

# Postgres (usado por docker-compose.yml y por application.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=divvy
DB_USER=divvy
DB_PASSWORD=divvy_dev_password
# DB_SSLMODE: "disable" en local, "require" en Neon (u otro proveedor gestionado).
DB_SSLMODE=disable

# JWT (application.yml -> divvy.jwt.*)
JWT_SECRET=change-me-in-production-this-is-a-dev-only-secret-key-32bytes+
JWT_EXPIRATION_MS=86400000

# Gmail SMTP (application.yml -> spring.mail.*)
# MAIL_USERNAME: tu dirección de Gmail.
# MAIL_PASSWORD: una "Contraseña de aplicación" de 16 caracteres (myaccount.google.com/apppasswords),
# NUNCA tu contraseña normal de Gmail. Nunca pongas el valor real aquí, solo en tu .env.
MAIL_USERNAME=
MAIL_PASSWORD=
PASSWORD_RESET_EXPIRATION_MINUTES=30

# App
# SERVER_PORT: usado en local. Render inyecta su propia variable PORT, que
# tiene prioridad automáticamente (ver application.yml -> server.port).
SERVER_PORT=8080
LOG_LEVEL=DEBUG

# CORS: orígenes permitidos separados por coma (sin espacios). En producción,
# reemplazar por el/los dominios reales del frontend (ej: https://divvy.app).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
